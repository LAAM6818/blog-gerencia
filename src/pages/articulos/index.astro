---
import MainLayout from '../../layouts/MainLayout.astro';
import Tarjetas from '../../components/tarjetasindex.astro';
import { getCollection } from 'astro:content';

// Obtener y ordenar todos los posts
const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Formatear fecha al estilo "14 Mayo, 2026"
function formatDate(date: Date): string {
  const day = date.getDate();
  const month = date.toLocaleDateString('es-ES', { month: 'long' });
  const year = date.getFullYear();
  return `${day} ${month.charAt(0).toUpperCase() + month.slice(1)}, ${year}`;
}
---

<MainLayout 
  title="Artículos" 
  siteName="blogger" 
  description="Explora todos nuestros artículos sobre tecnología y liderazgo."
>
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-5xl mx-auto text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight">
          Todos los <span class="text-indigo-600">Artículos</span>
        </h1>
        <div class="w-24 h-1.5 bg-indigo-600 mx-auto rounded-full mb-8"></div>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Una colección completa de guías, reflexiones y tutoriales sobre desarrollo de software y gestión de equipos técnicos.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-gray-500 text-lg">No hay artículos publicados todavía.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <Tarjetas
              title={post.data.title}
              description={post.data.description}
              date={formatDate(post.data.pubDate)}
              url={`/articulos/${post.id}`}
              image={post.data.banner || "https://images.unsplash.com/photo-1517694712202-14dd9538aa97"}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</MainLayout>
