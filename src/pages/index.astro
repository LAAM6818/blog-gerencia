---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout 
  title="Inicio" 
  siteName="Gerencia TI" 
  description="Gestión de Equipos y Tecnología - Artículos sobre diseño, desarrollo y productividad."
>
  <!-- SECCIÓN HERO -->
  <section class="relative -mt-10 mb-12 py-16 md:py-24 overflow-hidden">
    <!-- Decoración de fondo sutil -->
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-50 via-white to-purple-50 -z-10"></div>
    
    <div class="text-center max-w-3xl mx-auto px-4">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 mb-6">
        Gerencia del Área de <span class="text-black">Equipos y Tecnología</span>
      </h1>
      <p class="text-gray-600 text-lg md:text-xl leading-relaxed">
        Artículos sobre diseño, desarrollo web, productividad y creatividad. Escrito por mentes inquietas para el mundo profesional.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#recientes" class="bg-gray-900 text-white hover:bg-indigo-600 font-medium px-8 py-3 rounded-full transition-all shadow-lg hover:shadow-indigo-200">
          Ver lo último →
        </a>
        <a href="#" class="bg-white border border-gray-200 hover:border-indigo-300 text-gray-700 font-medium px-8 py-3 rounded-full transition-all shadow-sm">
          Explorar categorías
        </a>
      </div>
    </div>
  </section>

  <!-- BLOQUE PRINCIPAL: GRID DE ARTÍCULOS -->
  <section id="recientes" class="py-8">
    <div class="flex flex-wrap justify-between items-end mb-12 border-b border-gray-100 pb-6">
      <div>
        <h2 class="text-3xl font-bold text-gray-900">Artículos recientes</h2>
        <p class="text-gray-500 mt-2">Lo más nuevo en tecnología y gestión</p>
      </div>
      <a href="/articulos" class="text-indigo-600 font-semibold hover:text-indigo-800 inline-flex items-center gap-2 group">
        Ver todos los posts 
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

    <!-- GRID DE POSTS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      
      <!-- Artículo 1 -->
      <article class="group bg-white rounded-3xl border border-gray-100 overflow-hidden hover:shadow-2xl hover:shadow-indigo-100 hover:-translate-y-2 transition-all duration-300 flex flex-col">
        <div class="h-56 bg-gradient-to-r from-cyan-500 to-blue-600 flex items-center justify-center text-white relative">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 opacity-40 group-hover:scale-110 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
        </div>
        <div class="p-7 flex-1 flex flex-col">
          <div class="flex items-center gap-3 text-xs font-bold text-indigo-600 uppercase tracking-widest mb-3">
            <span class="bg-indigo-50 px-2 py-1 rounded">Diseño UI</span>
            <span class="text-gray-300">•</span>
            <span class="text-gray-500">5 min</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-indigo-600 transition-colors">El poder del espacio negativo en interfaces</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3">
            Exploramos cómo el respiro visual transforma la experiencia de usuario y mejora la legibilidad.
          </p>
          <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
            <span class="text-sm font-medium text-gray-700">J. Salinas</span>
            <a href="#" class="text-indigo-600 text-sm font-bold hover:underline">Leer más</a>
          </div>
        </div>
      </article>

      <!-- Artículo 2 (Copia el patrón para los demás) -->
      <article class="group bg-white rounded-3xl border border-gray-100 overflow-hidden hover:shadow-2xl hover:shadow-teal-100 hover:-translate-y-2 transition-all duration-300 flex flex-col">
        <div class="h-56 bg-gradient-to-r from-emerald-500 to-teal-600 flex items-center justify-center text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 opacity-40 group-hover:scale-110 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
        </div>
        <div class="p-7 flex-1 flex flex-col">
          <div class="flex items-center gap-3 text-xs font-bold text-teal-600 uppercase tracking-widest mb-3">
            <span class="bg-teal-50 px-2 py-1 rounded">Frontend</span>
            <span class="text-gray-300">•</span>
            <span class="text-gray-500">8 min</span>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">Tailwind vs CSS tradicional en 2025</h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3">Análisis profundo de productividad y rendimiento en equipos de desarrollo modernos.</p>
          <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
            <span class="text-sm font-medium text-gray-700">M. Rivera</span>
            <a href="#" class="text-teal-600 text-sm font-bold hover:underline">Leer más</a>
          </div>
        </div>
      </article>

      <!-- Puedes añadir más artículos aquí siguiendo la misma estructura -->

    </div>

    <!-- BOTÓN CARGAR MÁS -->
    <div class="text-center mt-20">
      
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-y-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>
  </section>

  <!-- SECCIÓN NEWSLETTER (Simplificada) -->
  
</MainLayout>