---
import MainLayout from '../layouts/MainLayout.astro';
import Tarjetas from '../components/tarjetasindex.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latestPosts = posts.slice(0, 3);

function formatDate(date: Date): string {
  const day = date.getDate();
  const month = date.toLocaleDateString('es-ES', { month: 'long' });
  const year = date.getFullYear();
  return `${day} ${month.charAt(0).toUpperCase() + month.slice(1)}, ${year}`;
}
---

<MainLayout 
  title="Inicio" 
  siteName="blog" 
  description="Exploramos la intersección entre el liderazgo humano y la infraestructura de vanguardia"
>
  <!-- HERO SECTION -->
 <section class="relative bg-[#0b1120] -mt-32 pt-48 pb-24 overflow-hidden left-1/2 right-1/2 ml-[-50vw] mr-[-50vw] w-screen">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-indigo-900/20 via-transparent to-transparent"></div>
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl">
        <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-[1.1] tracking-tight mb-8">
          Administración de Recursos Informáticos y Tecnológicos
        </h1>
        <p class="text-lg md:text-xl text-gray-400 max-w-2xl leading-relaxed mb-10">
          Estrategias y herramientas para maximizar la eficiencia y el valor de la infraestructura tecnológica.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#por-que-leer" class="px-8 py-4 bg-indigo-600 text-white font-bold rounded-lg hover:bg-indigo-500 transition-all shadow-lg shadow-indigo-500/20">
            Descubrir más
          </a>
          <a href="#articulos" class="px-8 py-4 bg-transparent border border-gray-700 text-white font-bold rounded-lg hover:bg-gray-800 transition-all">
            Explorar artículos
          </a>
        </div>
      </div>
    </div>
  </section>

 <section id="por-que-leer" class="py-24 bg-white">
  <div class="container mx-auto px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        
        <div class="w-24 h-1.5 bg-indigo-600 mx-auto rounded-full"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-start">
        <div class="space-y-6">
          <p class="text-xl text-gray-700 leading-relaxed font-medium">
            Administrar recursos tecnológicos no es solo mantener sistemas encendidos; es maximizar la eficiencia operativa y el retorno de inversión.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Este espacio está diseñado para líderes técnicos y administradores de sistemas que buscan ir más allá del código. Aquí exploramos cómo la <strong>administración de recursos informáticos</strong> se convierte en el pilar que sostiene el crecimiento de cualquier organización moderna, uniendo la técnica con la visión de negocio.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Desde la optimización del ciclo de vida del hardware hasta el despliegue de soluciones en la nube de alto rendimiento, cada artículo ofrece estrategias prácticas. Mi objetivo es proporcionarte las herramientas necesarias para transformar la infraestructura tecnológica en un activo estratégico que potencie el talento humano y la productividad.
          </p>
        </div>

        <div class="bg-gray-50 p-8 rounded-3xl border border-gray-100">
          <h3 class="text-2xl font-bold text-gray-900 mb-8">Ejes fundamentales:</h3>
          
          <ul class="space-y-6">
            <li class="flex gap-4">
              <div class="shrink-0 w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center mt-1">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Optimización de Activos</h4>
                <p class="text-sm text-gray-600">Estrategias para maximizar el rendimiento del hardware y software, garantizando una infraestructura sólida y escalable.</p>
              </div>
            </li>

            <li class="flex gap-4">
              <div class="shrink-0 w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center mt-1">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Gobierno de TI y Liderazgo</h4>
                <p class="text-sm text-gray-600">Metodologías para la gestión de equipos técnicos, flujos de trabajo eficientes y toma de decisiones basada en datos.</p>
              </div>
            </li>

            <li class="flex gap-4">
              <div class="shrink-0 w-6 h-6 rounded-full bg-indigo-600 flex items-center justify-center mt-1">
                <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Continuidad y Eficiencia</h4>
                <p class="text-sm text-gray-600">Análisis de arquitecturas cloud resilientes y de bajo costo operativo.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-16 p-8 bg-indigo-900 rounded-2xl text-center">
        <p class="text-indigo-100 text-lg italic">
          "La eficiencia tecnológica es el resultado de una administración consciente. No se trata de tener más recursos, sino de saber potenciar los que ya tenemos."
        </p>
      </div>
    </div>
  </div>
</section>
  
  <div id="articulos" class="py-24 bg-[#f8f9fc]">
    <div class="container mx-auto px-6">
      <div class="flex justify-between items-end mb-12">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Publicaciones Recientes</h2>
          <p class="text-gray-600">Explora las últimas publicacines.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map(post => (
          <Tarjetas
            title={post.data.title}
            description={post.data.description}
            date={formatDate(post.data.pubDate)}
            url={`/articulos/${post.id}`}
            image={post.data.banner || "https://images.unsplash.com/photo-1517694712202-14dd9538aa97"}
          />
        ))}
      </div>
    </div>
  </div>
</MainLayout>
